generator client {
  provider = "prisma-client-js"
}

generator json {
  provider = "prisma-json-types-generator"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Language {
  es
}

enum UserRole {
  super_admin
  admin
  support
  customer
}

enum UserStatus {
  active
  inactive
  blocked
  pending_profile
}

enum DocumentType {
  cc
  ce
  nit
  pp
  ti
}

enum Gender {
  female
  male
  non_binary
  prefer_not_to_say
}

enum ProductStatus {
  draft
  active
  inactive
  archived
}

model User {
  id                 String          @id @default(cuid())
  supabaseAuthUserId String?         @unique
  email              String          @unique
  role               UserRole        @default(customer)
  status             UserStatus      @default(pending_profile)
  emailVerifiedAt    DateTime?
  phoneVerifiedAt    DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  profile            UserProfile?
  addresses          UserAddress[]
  preferences        UserPreference?

  @@index([email])
  @@index([role])
  @@index([status])
}

model UserProfile {
  userId         String        @id
  firstName      String
  lastName       String
  phone          String?
  documentType   DocumentType?
  documentNumber String?
  birthDate      DateTime?
  gender         Gender?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([firstName, lastName])
  @@index([phone])
  @@index([documentType, documentNumber])
}

model UserAddress {
  id                   String   @id @default(cuid())
  userId               String
  label                String?
  recipientName        String
  phone                String?
  addressLine1         String
  addressLine2         String?
  neighborhood         String?
  city                 String
  department           String
  country              String   @default("CO")
  postalCode           String?
  deliveryInstructions String?
  isDefault            Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([city])
  @@index([department])
  @@index([isDefault])
}

model UserPreference {
  userId                   String    @id
  acceptsMarketingEmails   Boolean   @default(false)
  acceptsWhatsAppMarketing Boolean   @default(false)
  acceptedTermsAt          DateTime?
  acceptedPrivacyPolicyAt  DateTime?
  preferredLanguage        Language  @default(es)
  preferredCurrency        String    @default("COP")
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id             String            @id @default(cuid())
  name           String
  slug           String            @unique
  description    String?
  imageUrl       String?
  seoTitle       String?
  seoDescription String?
  sortOrder      Int               @default(0)
  isActive       Boolean           @default(true)
  deletedAt      DateTime?
  parentId       String?
  parent         Category?         @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[]        @relation("CategoryHierarchy")
  products       ProductCategory[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([parentId, sortOrder])
  @@index([deletedAt, isActive])
  @@index([name])
}

model Product {
  id               String               @id @default(cuid())
  name             String
  slug             String               @unique
  shortDescription String?
  longDescription  String?
  brand            String?
  seoTitle         String?
  seoDescription   String?
  featured         Boolean              @default(false)
  status           ProductStatus        @default(draft)
  deletedAt        DateTime?
  archivedAt       DateTime?
  categories       ProductCategory[]
  options          ProductOption[]
  variants         ProductVariant[]
  images           CatalogImage[]
  costs            CatalogCost[]
  copies           CatalogDuplication[] @relation("DuplicationSource")
  copiedBy         CatalogDuplication?  @relation("DuplicationTarget")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([status, deletedAt])
  @@index([deletedAt, updatedAt])
  @@index([featured, status])
  @@index([brand])
  @@index([name])
  @@index([archivedAt])
}

model ProductCategory {
  id         String   @id @default(cuid())
  productId  String
  categoryId String
  isPrimary  Boolean  @default(false)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())

  @@unique([productId, categoryId])
  @@index([categoryId])
  // PostgreSQL partial unique index `ProductCategory_one_primary_per_product_idx`
  // is defined in migration SQL because Prisma cannot express partial unique indexes.
  @@index([productId, isPrimary])
}

model ProductOption {
  id           String               @id @default(cuid())
  productId    String
  name         String
  displayOrder Int                  @default(0)
  product      Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values       ProductOptionValue[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([productId, name])
  @@index([productId, displayOrder])
}

model ProductOptionValue {
  id                  String                      @id @default(cuid())
  optionId            String
  value               String
  displayOrder        Int                         @default(0)
  option              ProductOption               @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variantOptionValues ProductVariantOptionValue[]
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  @@unique([optionId, value])
  @@index([optionId, displayOrder])
}

model ProductVariant {
  id                   String                      @id @default(cuid())
  productId            String
  sku                  String                      @unique
  priceCents           Int
  compareAtPriceCents  Int?
  stock                Int                         @default(0)
  stockRevision        Int                         @default(0)
  inventoryMinimum     Int?
  inventoryMovements   InventoryMovement[]
  orderLines           ManualOrderLine[]
  isActive             Boolean                     @default(true)
  isDefault            Boolean                     @default(false)
  displayOrder         Int                         @default(0)
  weightGrams          Int?
  widthMm              Int?
  heightMm             Int?
  lengthMm             Int?
  optionCombinationKey String
  deletedAt            DateTime?
  product              Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues         ProductVariantOptionValue[]
  images               CatalogImage[]
  costs                CatalogCost[]
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  @@unique([productId, optionCombinationKey])
  @@unique([id, productId])
  // PostgreSQL partial unique index `ProductVariant_one_default_per_product_idx`
  // is defined in migration SQL because Prisma cannot express partial unique indexes.
  @@index([productId, displayOrder])
  @@index([productId, deletedAt, isActive, stock])
  @@index([deletedAt, isActive])
}

enum CatalogImageStatus {
  pending
  ready
  failed
}

model CatalogCost {
  id          String          @id @default(cuid())
  productId   String
  variantId   String?
  name        String
  description String?
  amountCents Int
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId, productId], references: [id, productId], onDelete: Cascade)

  @@index([productId, variantId, deletedAt])
}

model CatalogImage {
  id             String             @id @default(cuid())
  productId      String
  variantId      String?
  product        Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant        ProductVariant?    @relation(fields: [variantId, productId], references: [id, productId], onDelete: Cascade)
  bucket         String
  path           String
  publicUrl      String
  fileName       String
  contentType    String
  size           Int
  altText        String             @default("")
  position       Int                @default(0)
  status         CatalogImageStatus @default(pending)
  uploadRevision String?
  deletedAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([productId, bucket, path])
  @@index([bucket, path])
  @@index([productId, variantId, status, deletedAt, position])
}

model CatalogDuplication {
  operationId       String   @id
  sourceProductId   String
  targetProductId   String   @unique
  sourceRevision    DateTime
  copyCosts         Boolean
  skippedCategories Int
  createdAt         DateTime @default(now())
  source            Product  @relation("DuplicationSource", fields: [sourceProductId], references: [id], onDelete: Restrict)
  target            Product  @relation("DuplicationTarget", fields: [targetProductId], references: [id], onDelete: Restrict)

  @@index([sourceProductId, createdAt])
}

model ProductVariantOptionValue {
  productVariantId String
  optionValueId    String
  variant          ProductVariant     @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  optionValue      ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Restrict)

  @@id([productVariantId, optionValueId])
  @@index([optionValueId])
}

enum InventoryMovementType {
  initial
  entry
  exit
  count
  reversal
  maintenance
}

model InventoryOperation {
  id          String              @id
  productId   String
  actorId     String
  requestHash String
  createdAt   DateTime            @default(now())
  movements   InventoryMovement[]
}

model InventoryMovement {
  id          String                @id @default(uuid())
  variantId   String
  variant     ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Restrict)
  revision    Int
  type        InventoryMovementType
  delta       Int
  before      Int
  after       Int
  actorId     String?
  actorLabel  String?
  reason      String
  reference   String?
  operationId String?
  operation   InventoryOperation?   @relation(fields: [operationId], references: [id], onDelete: Restrict)
  reversesId  String?               @unique
  reverses    InventoryMovement?    @relation("InventoryReversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversedBy  InventoryMovement?    @relation("InventoryReversal")
  createdAt   DateTime              @default(now())
  orderLink   OrderStockLink?

  @@unique([variantId, revision])
  @@index([variantId, createdAt, id])
  @@index([operationId])
}

enum ManualOrderStatus {
  draft
  confirmed
  cancelled
}

enum ManualOrderPayment {
  pending
  paid
}

enum ManualOrderDelivery {
  shipping
  pickup
}

enum ManualOrderFulfillment {
  pending
  preparing
  shipped
  ready
  delivered
}

enum OrderEventKind {
  created
  edited
  confirmed
  cancelled
  payment
  fulfillment
  returned
}

enum OrderStockPurpose {
  confirmation
  cancellation
  return
}

model ManualOrder {
  id             String                 @id @default(uuid())
  number         Int                    @unique @default(autoincrement())
  revision       Int                    @default(0)
  status         ManualOrderStatus      @default(draft)
  payment        ManualOrderPayment     @default(pending)
  delivery       ManualOrderDelivery
  fulfillment    ManualOrderFulfillment @default(pending)
  customerName   String
  customerPhone  String
  address        String?
  notes          String?
  subtotalCents  Int
  shippingCents  Int
  totalCents     Int
  createdById    String
  createdByLabel String
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  lines          ManualOrderLine[]
  events         OrderEvent[]
  operations     OrderOperation[]
  returns        OrderReturn[]
  stockLinks     OrderStockLink[]

  @@index([createdAt, id])
  @@index([status, fulfillment, payment])
}

model ManualOrderLine {
  id                String           @id @default(uuid())
  orderId           String
  variantId         String
  productId         String
  productName       String
  sku               String
  attributes        String
  quantity          Int
  unitPriceCents    Int
  catalogPriceCents Int
  priceReason       String?
  order             ManualOrder      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variant           ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Restrict)
  returns           OrderReturn[]
  stockLinks        OrderStockLink[]

  @@unique([orderId, variantId])
  @@unique([id, orderId])
  @@index([variantId])
}

model OrderOperation {
  id          String      @id
  orderId     String
  actorId     String
  requestHash String
  createdAt   DateTime    @default(now())
  order       ManualOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  event       OrderEvent?

  @@unique([id, orderId])
  @@index([orderId, createdAt])
}

model OrderEvent {
  id          String           @id @default(uuid())
  orderId     String
  operationId String           @unique
  kind        OrderEventKind
  actorId     String
  actorLabel  String
  reason      String?
  from        String?
  to          String?
  createdAt   DateTime         @default(now())
  order       ManualOrder      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  operation   OrderOperation   @relation(fields: [operationId, orderId], references: [id, orderId], onDelete: Restrict)
  returns     OrderReturn[]
  stockLinks  OrderStockLink[]

  @@unique([id, orderId])
  @@unique([operationId, orderId])
  @@index([orderId, createdAt, id])
}

model OrderReturn {
  id         String          @id @default(uuid())
  orderId    String
  eventId    String
  lineId     String
  received   Int
  resellable Int
  order      ManualOrder     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  event      OrderEvent      @relation(fields: [eventId, orderId], references: [id, orderId], onDelete: Restrict)
  line       ManualOrderLine @relation(fields: [lineId, orderId], references: [id, orderId], onDelete: Restrict)

  @@unique([eventId, lineId])
  @@index([lineId])
}

model OrderStockLink {
  id         String            @id @default(uuid())
  orderId    String
  eventId    String
  lineId     String
  movementId String            @unique
  purpose    OrderStockPurpose
  order      ManualOrder       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  event      OrderEvent        @relation(fields: [eventId, orderId], references: [id, orderId], onDelete: Restrict)
  line       ManualOrderLine   @relation(fields: [lineId, orderId], references: [id, orderId], onDelete: Restrict)
  movement   InventoryMovement @relation(fields: [movementId], references: [id], onDelete: Restrict)

  @@unique([eventId, lineId])
  @@index([orderId])
}
