generator client {
  provider = "prisma-client-js"
}

generator json {
  provider = "prisma-json-types-generator"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Language {
  es
}

enum UserRole {
  super_admin
  admin
  support
  customer
}

enum UserStatus {
  active
  inactive
  blocked
  pending_profile
}

enum DocumentType {
  cc
  ce
  nit
  pp
  ti
}

enum Gender {
  female
  male
  non_binary
  prefer_not_to_say
}

model User {
  id                 String          @id @default(cuid())
  supabaseAuthUserId String?         @unique
  email              String          @unique
  role               UserRole        @default(customer)
  status             UserStatus      @default(pending_profile)
  emailVerifiedAt    DateTime?
  phoneVerifiedAt    DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  profile            UserProfile?
  addresses          UserAddress[]
  preferences        UserPreference?

  @@index([email])
  @@index([role])
  @@index([status])
}

model UserProfile {
  userId         String       @id
  firstName      String
  lastName       String
  phone          String?
  documentType   DocumentType?
  documentNumber String?
  birthDate      DateTime?
  gender         Gender?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([firstName, lastName])
  @@index([phone])
  @@index([documentType, documentNumber])
}

model UserAddress {
  id                   String   @id @default(cuid())
  userId               String
  label                String?
  recipientName        String
  phone                String?
  addressLine1         String
  addressLine2         String?
  neighborhood         String?
  city                 String
  department           String
  country              String   @default("CO")
  postalCode           String?
  deliveryInstructions String?
  isDefault            Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([city])
  @@index([department])
  @@index([isDefault])
}

model UserPreference {
  userId                    String   @id
  acceptsMarketingEmails    Boolean  @default(false)
  acceptsWhatsAppMarketing  Boolean  @default(false)
  acceptedTermsAt           DateTime?
  acceptedPrivacyPolicyAt   DateTime?
  preferredLanguage         Language @default(es)
  preferredCurrency         String   @default("COP")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id             String     @id @default(cuid())
  name           String
  slug           String     @unique
  description    String?
  imageUrl       String?
  seoTitle       String?
  seoDescription String?
  sortOrder      Int        @default(0)
  isActive       Boolean    @default(true)
  deletedAt      DateTime?
  parentId       String?
  parent         Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[] @relation("CategoryHierarchy")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([parentId, sortOrder])
  @@index([deletedAt, isActive])
  @@index([name])
}
