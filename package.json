{
  "name": "e-commerce-silentium",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "npm install && npm run prisma:generate && next dev",
    "build": "npm run prisma:generate && next build",
    "prisma:generate": "prisma generate",
    "prisma:studio": "dotenv -e .env.development -- npx prisma studio",
    "prisma:migrate:dev:development": "dotenv -e .env.development -- npx prisma migrate dev",
    "prisma:migrate:deploy:production": "dotenv -e .env -- npx prisma migrate deploy",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "tsx prisma/seed.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.7",
    "@mui/lab": "^7.0.1-beta.20",
    "@mui/material": "^7.1.2",
    "@mui/system": "^7.1.1",
    "@mui/x-data-grid": "^8.0.0",
    "@mui/x-date-pickers": "^8.11.3",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^6.19.2",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.91.1",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "cookies": "^0.9.1",
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.3",
    "husky": "^9.1.7",
    "jotai": "^2.16.2",
    "lodash": "^4.17.23",
    "next": "16.1.3",
    "next-pwa": "^5.6.0",
    "notistack": "^3.0.2",
    "pg": "^8.17.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-dropzone": "^14.3.8",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.23",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.1.3",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^7.0.0",
    "prettier": "^3.4.2",
    "prettier-plugin-organize-imports": "^4.1.0",
    "prisma": "^6.19.2",
    "prisma-json-types-generator": "^3.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
